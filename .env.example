# Runtime
APP_NAME="Personal Finance API"
ENVIRONMENT=development
# O seed com senha pública demo1234 só é permitido em development/test.
DEBUG=true
COOKIE_SECURE=false
SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=168
# Logs técnicos sem vínculo financeiro são removidos pela rotina de manutenção
# depois deste prazo. Registros usados para idempotência permanecem.
AGENT_LOG_RETENTION_DAYS=180
DEFAULT_TIMEZONE=America/Manaus
# Published API/web ports bind only to loopback by default. For temporary
# testing from a trusted LAN device, use the host's specific LAN IP here.
APP_BIND_HOST=127.0.0.1
# Optional Compose host-port overrides (defaults: PostgreSQL 5432, API 8000,
# frontend 3000). E2E uses separate E2E_*_PORT variables automatically.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000

# Database (the Compose service uses the same values)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=personal_finance
DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/personal_finance

# Browser/API integration
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Internal Hermes -> FastAPI authentication. Change for any shared environment.
AGENT_SHARED_SECRET=local-agent-secret-change-me
PERSONAL_FINANCE_API_URL=http://127.0.0.1:8000/api/v1/integrations/agent
PERSONAL_FINANCE_AGENT_TIMEOUT=15

# Local LLM provider for the standalone runner (host process, not required for web MVP)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# O runner aceita até 180 s para máquinas CPU durante o primeiro carregamento.
LLM_TIMEOUT_SECONDS=180
# qwen2.5:3b foi usado no smoke runner deste host. Para o gateway Hermes,
# selecione um modelo local com contexto >= 64000 e suporte a tool calling.
OLLAMA_MODEL=qwen2.5:3b
# Modelo recomendado para o Hermes neste host (131072 tokens de contexto).
HERMES_OLLAMA_MODEL=llama3.2:3b
HERMES_WHATSAPP_BRIDGE_URL=http://127.0.0.1:3300
# Somente ao habilitar o modo bot do Hermes; nunca use wildcard. O número deve
# estar em E.164 e também vinculado/verificado na tela de Integrações.
# WHATSAPP_MODE=bot
# WHATSAPP_DM_POLICY=allowlist
# WHATSAPP_ALLOWED_USERS=+5592XXXXXXXXX

# Frontend build-time API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
