# Runtime
APP_NAME="Personal Finance API"
ENVIRONMENT=development
DEBUG=true
COOKIE_SECURE=false
SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=168
DEFAULT_TIMEZONE=America/Manaus

# Database (the Compose service uses the same values)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=personal_finance
DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/personal_finance

# Browser/API integration
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Internal Hermes -> FastAPI authentication. Change for any shared environment.
AGENT_SHARED_SECRET=local-agent-secret-change-me
PERSONAL_FINANCE_API_URL=http://127.0.0.1:8000/api/v1/integrations/agent
PERSONAL_FINANCE_AGENT_TIMEOUT=15

# Local LLM provider for the standalone runner (host process, not required for web MVP)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Frontend build-time API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
